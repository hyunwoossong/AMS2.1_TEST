			,EDI_INP_T = #EDI_INP_T#
			<isNotEmpty property="ORG_MSG">
				,ORIGIN_MSG = UTL_COMPRESS.LZ_COMPRESS(#ORG_MSG:BLOB#)
			</isNotEmpty>
			<isNotEmpty property="CONV_MSG">
				,CONV_MSG = UTL_COMPRESS.LZ_COMPRESS(#CONV_MSG:BLOB#)
			</isNotEmpty>
			<isNotEmpty property="MULTI_MSG">
				,MULTI_MSG = UTL_COMPRESS.LZ_COMPRESS(#MULTI_MSG:BLOB#)
			</isNotEmpty>
			<isNotEmpty property="AMS_ACK">
				,AMS_ACK = UTL_COMPRESS.LZ_COMPRESS(#AMS_ACK:BLOB#)
			</isNotEmpty>
			<isNotEmpty property="MSB_ACK">
				,MSB_ACK = UTL_COMPRESS.LZ_COMPRESS(#MSB_ACK:BLOB#)
			</isNotEmpty>
			<isNotEmpty property="AIR_ACK">
				,AIR_ACK = UTL_COMPRESS.LZ_COMPRESS(#AIR_ACK:BLOB#)
			</isNotEmpty>
			<isNotEmpty property="KAMS_ACK">
				,KAMS_ACK = UTL_COMPRESS.LZ_COMPRESS(#KAMS_ACK:BLOB#)
			</isNotEmpty>
			<isNotEmpty property="TYPEB">
				,TYPEB_MSG = UTL_COMPRESS.LZ_COMPRESS(#TYPEB:BLOB#)
			</isNotEmpty>
			<isNotEmpty property="KTNET_FHL">
				,KTNET_MSG = UTL_COMPRESS.LZ_COMPRESS(#KTNET_FHL:BLOB#)
			</isNotEmpty>
			<isNotEmpty property="KTNET_MANIFEST_FHL">
				,KTNET_MANIFEST_MSG = UTL_COMPRESS.LZ_COMPRESS(#KTNET_MANIFEST_FHL:BLOB#)
			</isNotEmpty>
			<isNotEmpty property="KCNET_MANIFEST_FHL">
				,KCNET_MANIFEST_MSG = UTL_COMPRESS.LZ_COMPRESS(#KCNET_MANIFEST_FHL:BLOB#)
			</isNotEmpty>
			,FLT_NO = #FLT_NO#
			,FLT_DATE = #FLT_DATE#
			,DEP = #DEP#
			,ARR = #ARR#
			,ORG = #ORG#
			,DST = #DST#
			,CSTM_COD_C_3 = #CSTM_COD_C_3#
			,CSTM_COD_C = #CSTM_COD_C#
			,UPT_INP_D = TO_CHAR(SYSDATE, 'yyyyMMdd')
			,UPT_INP_T = TO_CHAR(SYSDATE, 'hh24Miss')
			<isNotEmpty property="AMS_SMI">
				,AMS_SMI = #AMS_SMI#
			</isNotEmpty>
			<isNotEmpty property="IKAMS_SMI">
				,IKAMS_SMI = #IKAMS_SMI#
			</isNotEmpty>
			<isEqual property="AMS_SMI" compareValue="FNA">
			,EFREGIT_DONE_YN = 'N'
			</isEqual>
			<isEqual property="REPROC" compareValue="Y">
			,REPROC = 'Y'
			</isEqual>
			<isNotEmpty property="ERRORMSG">
				,ERRORMSG = #ERRORMSG#
			</isNotEmpty>
			<isNotEmpty property="ERRORMSG_KOR">
				,ERRORMSG_KOR = #ERRORMSG_KOR#
			</isNotEmpty>
			<isNotEmpty property="IKAMS_ERRMSG">
				,IKAMS_ERRMSG = #IKAMS_ERRMSG#
			</isNotEmpty>
			<isNotEmpty property="IKAMS_ERRMSG_KOR">
				,IKAMS_ERRMSG_KOR = #IKAMS_ERRMSG_KOR#
			</isNotEmpty>
			<isNotEmpty property="OUT_AMS_FLAG">
				,OUT_AMS_FLAG = #OUT_AMS_FLAG#
			</isNotEmpty>
			<isNotEmpty property="OUT_KAMS_FLAG">
				,OUT_KAMS_FLAG = #OUT_KAMS_FLAG#
			</isNotEmpty>
		WHERE TRX_ROUTE = #AMS_TRX_ROUTE#
	</update>

	<update id="UpdateTgtPoint" parameterClass="map">
		UPDATE TM_TRACE
		SET
			TGT_POINT = #TGT_POINT#
			,IKAMS_POINT = #IKAMS_POINT#
			,ROUTE_POINT = #ROUTE_POINT#
			,IKAMS_ROUTE_POINT = #IKAMS_ROUTE_POINT#
		WHERE TRX_ROUTE = #AMS_TRX_ROUTE#
	</update>

