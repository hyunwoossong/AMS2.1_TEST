<sqlMap namespace="INSERT_UPDATE">

	<update id="insertTraceHistory" parameterClass="map">
		INSERT INTO TM_TRACE_HISTORY
		(
			 TRX_ROUTE
			,STEP
			,IKAMS_STEP
			,STATUS
		)VALUES(
			 #AMS_TRX_ROUTE#
			,#AMS_STEP#
			,#IKAMS_STEP#
			,#HISTORY_STATUS#
		)
	</update>

	<update id="insertTrace" parameterClass="map">
		INSERT INTO TM_TRACE
		(
			 TRX_ROUTE
			 ,KTNET_ROUTE
			 ,ORIGIN_MSG
		)VALUES(
			 #AMS_TRX_ROUTE#
			 ,#KTNET_ROUTE#
			 <isNotEmpty property="ORG_MSG">
			 ,UTL_COMPRESS.LZ_COMPRESS(#ORG_MSG:BLOB#)
			 </isNotEmpty>
		)
	</update>

	<update id="reprocTrace" parameterClass="map">
		UPDATE TM_TRACE
		SET
			REPROC = 'Y'
		WHERE TRX_ROUTE = #RE_TRX_ROUTE#
	</update>

	<update id="UpdateTrace" parameterClass="map">
		UPDATE TM_TRACE
		SET
			ORG_ROUTE = #ORG_ROUTE#
			<isNotEmpty property="AMS_STEP">
			,STEP = #AMS_STEP#
			</isNotEmpty>
			<isNotEmpty property="IKAMS_STEP">
			,IKAMS_STEP = #IKAMS_STEP#
			</isNotEmpty>
			,SMI = #SMI#
			,VERSION = #VERSION#
			,CON_VERSION= #CON_VERSION#
			,SRC_POINT = #SRC_POINT#
			,SRC_PIMA = #SRC_PIMA#
			,TGT_POINT = #TGT_POINT#
			,TGT_PIMA = #TGT_PIMA#
