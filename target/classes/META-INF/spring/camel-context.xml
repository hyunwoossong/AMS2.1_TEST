	<bean id="cargoimpcheck" class="com.trx.validate.CargoImpCheck" />
	<bean id="validationdoc" class="com.trx.validate.ValidationDoc" />
	<bean id="ikamsvalidationdoc" class="com.trx.validate.IkamsValidationDoc" />
	<bean id="validationbiz" class="com.trx.validate.ValidationBiz" />
	<bean id="routing" class="com.trx.Msgprocess.Routing" />
	<bean id="ikamsrouting" class="com.trx.Msgprocess.IkamsRouting" />
	<bean id="routingbiz" class="com.trx.Msgprocess.RoutingBIZ" />
	<bean id="dbinserttrace" class="com.trx.db.DbinsertTrace" />
	<bean id="mainExceptionManager" class="com.trx.util.MainExceptionManager" />
	<bean id="common" class="com.trx.util.CommonUtil" />
	<bean id="commonSql" class="com.trx.util.CommonSql" />

	<bean id="uuidGenerator" class="org.apache.camel.impl.ActiveMQUuidGenerator" />


