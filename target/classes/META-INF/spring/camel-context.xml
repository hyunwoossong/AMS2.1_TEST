	<context:annotation-config />

	<!-- AMB DB 설정 정보 -->
	<bean id="dataSource" class="org.apache.commons.dbcp.BasicDataSource"
		destroy-method="close">
		<property name="driverClassName" value="oracle.jdbc.driver.OracleDriver" />
		<!-- 개발 서버 접속 정보 -->
		<!-- <property name="url" value="jdbc:oracle:thin:@172.16.100.12:1531:GLMSB"
			/> <property name="username" value="TRAXON" /> <property name="password"
			value="TRAXON41#" /> -->
		<!-- 개발 서버 접속 정보 -->
		<property name="url" value="#{prop['amsdb.url']}" />
		<property name="username" value="#{prop['amsdb.id']}" />
		<property name="password" value="#{prop['amsdb.pw']}" />

		<property name="maxActive" value="10" /> <!-- connection 갯수 -->
		<property name="initialSize" value="1" />
		<property name="maxIdle" value="5" />
		<property name="minIdle" value="1" />
		<!-- <property name="validationQuery" value="SELECT 1 FROM DUAL" /> -->
		<property name="testOnBorrow" value="false" />
		<property name="testOnReturn" value="false" />
		<property name="timeBetweenEvictionRunsMillis" value="10000" />
		<property name="testWhileIdle" value="true" />
		<property name="numTestsPerEvictionRun" value="3" />
		<property name="minEvictableIdleTimeMillis" value="-1" />
	</bean>

	<!-- SqlMapClient -->
	<bean id="sqlMapClient" class="org.springframework.orm.ibatis.SqlMapClientFactoryBean">
		<property name="configLocation" value="classpath:SqlMapConfig.xml" />
		<property name="dataSource" ref="dataSource" />
		<property name="transactionConfigClass"
			value="com.ibatis.sqlmap.engine.transaction.jdbc.JdbcTransactionConfig" />
		<property name="transactionConfigProperties">
			<props>
				<prop key="DefaultAutoCommit">false</prop>
				<prop key="SetAutoCommitAllowed">true</prop>
			</props>
		</property>
		<property name="mappingLocations">
			<list>
				<value>classpath:com/trx/ibatis/sql/*.xml</value>
			</list>
		</property>
	</bean>

	<!-- Transaction Manager -->
	<bean id="transactionManager"
		class="org.springframework.jdbc.datasource.DataSourceTransactionManager">
		<property name="dataSource" ref="dataSource" />
	</bean>

	<bean id="ibatis" class="org.apache.camel.component.ibatis.IBatisComponent">
		<property name="sqlMapClient" ref="sqlMapClient" />
	</bean>

	<!-- MSB DB 설정 정보 -->
	<bean id="msbdataSource" class="org.apache.commons.dbcp.BasicDataSource"
		destroy-method="close">
		<property name="driverClassName" value="oracle.jdbc.driver.OracleDriver" />
		<!-- 개발 서버 접속 정보 -->
		<!-- <property name="url" value="jdbc:oracle:thin:@172.16.100.12:1531:GLMSB"
			/> <property name="username" value="TRAXON" /> <property name="password"
			value="TRAXON41#" /> -->
		<!-- 개발 서버 접속 정보 -->
		<property name="url" value="#{prop['msbdb.url']}" />
		<property name="username" value="#{prop['msbdb.id']}" />
		<property name="password" value="#{prop['msbdb.pw']}" />

		<property name="maxActive" value="10" /> <!-- connection 갯수 -->
		<property name="initialSize" value="1" />
		<property name="maxIdle" value="5" />
		<property name="minIdle" value="1" />
		<!-- <property name="validationQuery" value="SELECT 1 FROM DUAL" /> -->
		<property name="testOnBorrow" value="false" />
		<property name="testOnReturn" value="false" />
		<property name="timeBetweenEvictionRunsMillis" value="10000" />
		<property name="testWhileIdle" value="true" />
		<property name="numTestsPerEvictionRun" value="3" />
		<property name="minEvictableIdleTimeMillis" value="-1" />
	</bean>

	<!-- SqlMapClient -->
	<bean id="sqlMapClient_msb" class="org.springframework.orm.ibatis.SqlMapClientFactoryBean">
		<property name="configLocation" value="classpath:SqlMapConfig.xml" />
		<property name="dataSource" ref="msbdataSource" />
		<property name="transactionConfigClass"
			value="com.ibatis.sqlmap.engine.transaction.jdbc.JdbcTransactionConfig" />
		<property name="transactionConfigProperties">
			<props>
				<prop key="DefaultAutoCommit">false</prop>
				<prop key="SetAutoCommitAllowed">true</prop>
			</props>
		</property>
		<property name="mappingLocations">
			<list>
				<value>classpath:com/trx/ibatis/sql/*.xml</value>
			</list>
		</property>
	</bean>

	<!-- Transaction Manager -->
	<bean id="transactionManager_msb"
		class="org.springframework.jdbc.datasource.DataSourceTransactionManager">
		<property name="dataSource" ref="msbdataSource" />
	</bean>

	<bean id="msbibatis" class="org.apache.camel.component.ibatis.IBatisComponent">
		<property name="sqlMapClient" ref="sqlMapClient_msb" />
	</bean>

	<!-- ActiveMQ 98번 -->
	<bean id="activeMQConnectionFactory" class="org.apache.activemq.ActiveMQConnectionFactory">
		<property name="brokerURL" value="#{prop['amq98.url']}" />
		<property name="userName" value="#{prop['amq98.id']}" />
		<property name="password" value="#{prop['amq98.pw']}" />
		<property name="prefetchPolicy">
			<bean class="org.apache.activemq.ActiveMQPrefetchPolicy">
				<property name="queuePrefetch" value="0" />
			</bean>
		</property>
	</bean>
	<!-- MQ connection cache 속도 향상 -->
	<bean id="amqConnectionFactory" class="org.springframework.jms.connection.CachingConnectionFactory">
		<property name="targetConnectionFactory" ref="activeMQConnectionFactory" />
		<property name="cacheConsumers" value="false" />
		<property name="reconnectOnException" value="true" />
	</bean>

	<bean id="amqTxManager" class="org.springframework.jms.connection.JmsTransactionManager">
		<property name="connectionFactory" ref="amqConnectionFactory" />
	</bean>
<!-- 	AMQ transactionManager -->
	<bean id="amqTransactionPolicy" class="org.apache.camel.spring.spi.SpringTransactionPolicy">
		<property name="transactionManager" ref="amqTxManager" />
		<property name="propagationBehaviorName" value="PROPAGATION_REQUIRED" />
	</bean>

	<bean id="amq" class="org.apache.activemq.camel.component.ActiveMQComponent">
		<property name="connectionFactory" ref="amqConnectionFactory" />
		<property name="transactionManager" ref="amqTxManager" />
	<!-- 	<property name="concurrentConsumers" value="5" /> -->
		<property name="transacted" value="true" />
	</bean>



