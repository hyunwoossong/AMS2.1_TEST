												<simple>${header.BODY} contains 'OCI/KR/EXP/I/' or ${header.BODY} contains 'OCI/KR/IMP/I/' or ${header.BODY} contains 'OCI/KR/EXP/X/'</simple>
													<log message="=============== IKAMS START ===============" />
													<to uri="direct:IKAMS_SEND"/>
											</when>
											<otherwise>
												<log message="=============== AMS START ===============" />
												<to uri="direct:AMS_SEND"/>
											</otherwise>
										</choice>
										<log message="=============== AMS/IKAMS Check End ===============" />
									</when>
									<otherwise>
										<choice>
											<when>
												<simple>${header.BODY} contains 'OCI/KR/EXP/M/' or ${header.BODY} contains 'OCI/KR/IMP/M/' or ${header.BODY} contains 'OCI/KR/EXP/A/' or ${header.BODY} contains 'OCI/KR/EXP/E/'</simple>
													<to uri="bean:validationdoc?method=validationDoc" />
											</when>
											<when>
												<simple>${header.BODY} contains 'OCI/KR/EXP/I/' or ${header.BODY} contains 'OCI/KR/IMP/I/' or ${header.BODY} contains 'OCI/KR/EXP/X/'</simple>
													<to uri="bean:ikamsvalidationdoc?method=ikamsvalidationDoc" />
											</when>
										</choice>
									</otherwise>
								</choice>
							</when>
							<otherwise>
								<choice>
									<when>
										<simple>${header.BODY} contains 'OCI/KR/EXP/M/' or ${header.BODY} contains 'OCI/KR/IMP/M/' or ${header.BODY} contains 'OCI/KR/EXP/A/' or ${header.BODY} contains 'OCI/KR/EXP/E/'</simple>
											<to uri="bean:validationdoc?method=validationDoc" />
									</when>
									<when>
										<simple>${header.BODY} contains 'OCI/KR/EXP/I/' or ${header.BODY} contains 'OCI/KR/IMP/I/' or ${header.BODY} contains 'OCI/KR/EXP/X/'</simple>
											<to uri="bean:ikamsvalidationdoc?method=ikamsvalidationDoc" />
									</when>
								</choice>
							</otherwise>
						</choice>
					</when>
				</choice>
				<log message="=============== IMP.FHLSPC2AMS.LQ End ===============" />
			</otherwise>
		</choice>
	</route>

	<!-- AMS -->
	<route id="AMS">
	<from uri="direct:AMS_SEND" />
	<log message="=============== AMS ROUTING START ===============" />
		<to uri="bean:validationdoc?method=validationDoc" />
			<choice>
				<when>
					<simple>${header.AMS_Validation_Check_Flag} == true</simple>
					<to uri="bean:routing?method=routing" />
					<choice>
						<when>
							<simple>${header.AIR_CARR_CODE} == '7C'</simple>
							<to uri="bean:routingbiz?method=routing7CBIZ"/>
						</when>
					</choice>
				</when>
			</choice>
	<log message="=============== AMS ROUTING END ===============" />
	</route>

	<!-- IKAMS -->
	<route id="IKAMS">
	<from uri="direct:IKAMS_SEND" />
	<log message="=============== IKAMS ROUTING START ===============" />
		<to uri="bean:ikamsvalidationdoc?method=ikamsvalidationDoc" />
			<choice>
				<when>
					<simple>${header.IKAMS_Validation_Check_Flag} == true</simple>
				 	<to uri="bean:ikamsrouting?method=ikamsrouting" />
				</when>
			</choice>
	<log message="=============== IKAMS ROUTING END ===============" />
	</route>

	<route id="AMS2MSB_QUEUESEND">
		<from uri="direct:AMS2MSBqueuesend" />
		<log message="=============== AMS2MSB QUEUE Send ===============" />
			<to uri="amq:queue:AMS2MSB.LQ?jmsMessageType=Text" />
		 	<to uri="stream:out" />
		 	<to uri="file://{{fhl.write.path}}?fileName=${date:now:yyyyMMdd}/${header.FILENAME}" />
		 <log message="=============== AMS2MSB QUEUE Send End ===============" />
	</route>

	<route id="AMS2TYPEB_QUEUESEND">
		<from uri="direct:AMS2TYPEBqueuesend" />
		<log message="=============== AMS2TYPEB QUEUE Send ===============" />
			<to uri="amq:queue:TRAXON.AKE1MHS.TYPEB.CONVERT?jmsMessageType=Text" />
		 	<to uri="stream:out" />
			<to uri="file://{{typeb.write.path}}?fileName=${date:now:yyyyMM}/${header.TYPEBFILE}" />
		 <log message="=============== AMS2TYPEB QUEUE Send End ===============" />
	</route>

	<route id="AMS2KTNETAMS_QUEUESEND">
		<from uri="direct:AMS2KTNETAMSqueuesend" />
		<log message="=============== AMS2KTNET AMS QUEUE Send ===============" />
			<!-- <to uri="amq:queue:AMS2KTNETAMS.LQ?jmsMessageType=Text" /> -->
			<to uri="amq:queue:AMS2KTNETFHL.LQ?jmsMessageType=Text" />
		 	<to uri="stream:out" />
		 	<to uri="file://{{ktnet.ams.write.path}}?fileName=${date:now:yyyyMM}/${header.KTAMSFILE}" />
		 <log message="=============== AMS2KTNET AMS QUEUE Send End ===============" />
	</route>

	<route id="AMS2KTNETFHL_QUEUESEND">
		<from uri="direct:AMS2KTNETFHLqueuesend" />
		<log message="=============== AMS2KTNET FHL QUEUE Send ===============" />
			<to uri="amq:queue:AMS2KTNETFHL.LQ?jmsMessageType=Text" />
		 	<to uri="stream:out" />
		 	<to uri="file://{{ktnet.fhl.write.path}}?fileName=${date:now:yyyyMM}/${header.KTFHLFILE}" />
		 <log message="=============== AMS2KTNET FHL QUEUE Send End ===============" />
	</route>

	<!--  KCNET FHL AMQ 전송 -->
	<route id="AMS2KCNETFHL_QUEUESEND">
		<from uri="direct:AMS2KCNETFHLqueuesend" />
		<log message="=============== AMS2KCNET FHL QUEUE Send ===============" />
			<to uri="amq:queue:AMS2KCNETFHL.LQ?jmsMessageType=Text" />
		 	<to uri="stream:out" />
		 	<to uri="file://{{kcnet.fhl.write.path}}?fileName=${date:now:yyyyMM}/${header.KCFHLFILE}" />
		 <log message="=============== AMS2KCNET FHL QUEUE Send End ===============" />
	</route>

	<route id="MSB2AMS_ACK">
		<!-- <from uri="file:D:/EXPORT/RCVD/ACK?delete=true&amp;delay=10" />  -->
		<from uri="amq:queue:MSB2AMS.LQ?jmsMessageType=Text&amp;concurrentConsumers=1&amp;maxConcurrentConsumers=3&amp;idleConsumerLimit=2" />
		<transacted ref="amqTransactionPolicy" />
		<log message="=============== MSB2AMS ACK Create Start ===============" />
			<to uri="bean:ackheadercheck?method=ackheaderCheck" />
			<to uri="bean:ackselect?method=orgrouteSelect" />
		 <log message="=============== MSB2AMS ACK Create End ===============" />
	</route>

 	<route id="AMSACK_QUEUESEND">
		<from uri="direct:AMSACKqueuesend" />
		<log message="=============== AMS.FHLACK2AMS Queue Send ===============" />
			<to uri="amq:queue:AMS.FHLACK2AMS.LQ?jmsMessageType=Text" />
			<to uri="stream:out" />
			<to uri="file://{{ack.write.path}}?fileName=${date:now:yyyyMMdd}/${header.ACKFILE}" />
		 <log message="=============== AMS.FHLACK2AMS Queue Send End ===============" />
	</route>

    <route id="IKAMS_EXP_ACK">
		 <from uri="timer://select?delay=10000&amp;period=30000" />
		 <log message="=============== IKAMS EXP ACK Check ===============" />
			 <to uri="bean:ackselect?method=ikamsEXPAck" />
			 <to uri="stream:out" />
		 <log message="=============== IKAMS EXP ACK Check End ===============" />
	</route>

   	<route id="IKAMS_IMP_ACK">
		 <from uri="timer://select?delay=10000&amp;period=30000" />
		 <log message="=============== IKAMS IMP ACK Check ===============" />
			 <to uri="bean:ackselect?method=ikamsIMPAck" />
			 <to uri="stream:out" />
		 <log message="=============== IKAMS IMP ACK Check End ===============" />
	</route>

	<route id="WEB_REPROC">
		<from uri="amq:queue:RE2AMS.LQ?jmsMessageType=Text&amp;concurrentConsumers=1&amp;maxConcurrentConsumers=3&amp;idleConsumerLimit=2" />
			<transacted ref="amqTransactionPolicy" />
			<convertBodyTo type="java.lang.String"/>
			<log message="${body}"/>
			<to uri="bean:headercheck?method=smiCheck" />
		<choice>
			<when>
				<simple>${header.HEADER_SMI} == 'FWB'</simple>
				<log message="${body}"/>
				<to uri="amq:queue:EAWB.FWB2EAWB.LQ?jmsMessageType=Text" />
				<to uri="file://{{file.errorDir}}?fileName=${bean:common?method=getCurrentTime}" />
				<log message="=============== FWB Input Error ==============="/>
			</when>
			<otherwise>
				<log message="=============== REPROCESS AMS Start ===============" />
				<to uri="bean:reverseKey?method=mainStart" />
				<to uri="bean:headercheck?method=headerCheck" />
				<choice>
					<when>
						<simple>${header.HEADER_CHECK_FLAG} == true</simple>
						<to uri="bean:pimacheck?method=PimaCheck" />
						<choice>
							<when>
								<simple>${header.Pima_Check_Flag} == true</simple>
								<to uri="bean:airlinecheck?method=airlineSelect"/>
						 		<choice>
									<when>
										<simple>${header.Air_Check_Flag} == true</simple>
										<log message="=============== AMS/IKAMS Check ===============" />
										<choice>
											<when>
												<simple>${header.BODY} contains 'OCI/KR/EXP/M/' or ${header.BODY} contains 'OCI/KR/IMP/M/'</simple>
													<log message="=============== AMS START ===============" />
													<to uri="direct:AMS_SEND"/>
													<choice>
														<when>
															<simple>${header.AMS_ROUTING_FLAG} == true</simple>
																<log message="=============== IKAMS START ===============" />
																<to uri="direct:IKAMS_SEND"/>
														</when>
													</choice>
											</when>
											<when>
												<simple>${header.BODY} contains 'OCI/KR/EXP/A/' or ${header.BODY} contains 'OCI/KR/EXP/E/'</simple>
													<log message="=============== AMS START ===============" />
													<to uri="direct:AMS_SEND"/>
											</when>
											<when>
											<!-- 20161115 FLAG 'X' 추가 -->
												<simple>${header.BODY} contains 'OCI/KR/EXP/I/' or ${header.BODY} contains 'OCI/KR/IMP/I/' or ${header.BODY} contains 'OCI/KR/EXP/X/'</simple>
													<log message="=============== IKAMS START ===============" />
													<to uri="direct:IKAMS_SEND"/>
											</when>
											<otherwise>
												<log message="=============== AMS START ===============" />
												<to uri="direct:AMS_SEND"/>
											</otherwise>
										</choice>
										<log message="=============== AMS/IKAMS Check End ===============" />
									</when>
									<otherwise>
										<choice>
											<when>
												<simple>${header.BODY} contains 'OCI/KR/EXP/M/' or ${header.BODY} contains 'OCI/KR/IMP/M/' or ${header.BODY} contains 'OCI/KR/EXP/A/' or ${header.BODY} contains 'OCI/KR/EXP/E/'</simple>
													<to uri="bean:validationdoc?method=validationDoc" />
											</when>
											<when>
												<simple>${header.BODY} contains 'OCI/KR/EXP/I/' or ${header.BODY} contains 'OCI/KR/IMP/I/' or ${header.BODY} contains 'OCI/KR/EXP/X/'</simple>
													<to uri="bean:ikamsvalidationdoc?method=ikamsvalidationDoc" />
											</when>
										</choice>
									</otherwise>
								</choice>
							</when>
							<otherwise>
								<choice>
									<when>
										<simple>${header.BODY} contains 'OCI/KR/EXP/M/' or ${header.BODY} contains 'OCI/KR/IMP/M/' or ${header.BODY} contains 'OCI/KR/EXP/A/' or ${header.BODY} contains 'OCI/KR/EXP/E/'</simple>
											<to uri="bean:validationdoc?method=validationDoc" />
									</when>
									<when>
										<simple>${header.BODY} contains 'OCI/KR/EXP/I/' or ${header.BODY} contains 'OCI/KR/IMP/I/' or ${header.BODY} contains 'OCI/KR/EXP/X/'</simple>
											<to uri="bean:ikamsvalidationdoc?method=ikamsvalidationDoc" />
									</when>
								</choice>
							</otherwise>
						</choice>
					</when>
				</choice>
				 <log message="=============== REPROCESS AMS End ===============" />
			</otherwise>
		</choice>
	</route>
  </camel:camelContext>

</beans>

